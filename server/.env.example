# Vigil API settings
PORT=3000
# Enables demo-only reset tokens when email delivery is not configured.
# Set to false outside local hackathon demos.
DEMO_MODE=true

# SQL Server defaults target LocalDB and the CampusSafetyApp database.
# Override these for SQL Server Express or a full SQL Server instance.
DB_SERVER=(localdb)\MSSQLLocalDB
DB_DATABASE=CampusSafetyApp
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_TRUSTED_CONNECTION=true

# Optional full connection string. If set, it takes precedence over the fields above.
# DB_CONNECTION_STRING=Server=(localdb)\MSSQLLocalDB;Database=CampusSafetyApp;Trusted_Connection=True;TrustServerCertificate=True;

# Optional email delivery for password resets and emergency notifications.
# Without these, the API still works and reports notification actions as simulated.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vigil Campus Safety <onboarding@resend.dev>
API_PUBLIC_BASE_URL=http://localhost:3000

# Optional Gmail SMTP delivery for Safe Walk guardian email notifications.
# Use a Gmail App Password, not your normal Google account password.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

CAMPUS_SECURITY_EMAIL=
ATLAS_SECURITY_PHONE=0861 585 585
ATLAS_SECURITY_EMAIL=info@atlas24.co.za
CITYWIDE_SECURITY_PHONE=041 072 084
CITYWIDE_SECURITY_EMAIL=tech@citywide.co.za
